# =============================================================================
# Azure Environment Variables Template
# Copy this file to .env and fill in your actual values
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# Azure Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Azure subscription and resource group
AZURE_SUBSCRIPTION_ID=c09f5850-099b-4458-ac6d-f31d69f68ae7
AZURE_TENANT_ID=5b973f99-77df-4beb-b27d-aa0c70b8482c
AZURE_RESOURCE_GROUP=rg-credit-risk-clean

# Azure region
AZURE_LOCATION=uksouth

# ─────────────────────────────────────────────────────────────────────────────
# Storage Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Storage account
AZURE_STORAGE_ACCOUNT_NAME=creditriskstorageacc
AZURE_STORAGE_CONNECTION_STRING=<your_storage_connection_string>

# File shares
DB_FILE_SHARE=credit-risk-db
VECTOR_DB_FILE_SHARE=credit-risk-vector-db

# Blob containers
DOCUMENTS_CONTAINER=credit-risk-documents

# ─────────────────────────────────────────────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Main database
DATABASE_PATH=/home/data/credit_risk.db
DATABASE_BACKUP_PATH=/home/data/backups

# Vector database
VECTOR_DB_PATH=/home/vector_data/vector_database.db
VECTOR_DB_BACKUP_PATH=/home/vector_data/backups

# PDF storage
PDF_STORAGE_PATH=/home/documents/pdfs

# ─────────────────────────────────────────────────────────────────────────────
# Web Application Configuration
# ─────────────────────────────────────────────────────────────────────────────

# App Service
AZURE_WEBAPP_NAME=credit-risk-final
AZURE_WEBAPP_URL=https://credit-risk-final.azurewebsites.net

# Flask configuration
FLASK_APP=main.py
FLASK_ENV=production
FLASK_PORT=5002

# Gunicorn configuration
WEB_CONCURRENCY=2
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=0
GUNICORN_BIND=0.0.0.0:5002

# ─────────────────────────────────────────────────────────────────────────────
# Azure OpenAI Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Azure OpenAI endpoint
AZURE_OPENAI_ENDPOINT=https://data-risk-modernisation-OAI.openai.azure.com/
AZURE_OPENAI_API_KEY=<your_azure_openai_api_key>
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Model deployment names
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Fallback to OpenAI (optional)
OPENAI_API_KEY=<your_openai_api_key>
USE_AZURE_OPENAI=true

# ─────────────────────────────────────────────────────────────────────────────
# Companies House API
# ─────────────────────────────────────────────────────────────────────────────

COMPANIES_HOUSE_API_KEY=<your_companies_house_api_key>
COMPANIES_HOUSE_BASE_URL=https://api.company-information.service.gov.uk

# ─────────────────────────────────────────────────────────────────────────────
# Application Features
# ─────────────────────────────────────────────────────────────────────────────

# Enable/disable features
ENABLE_AGENTIC_WORKFLOWS=true
ENABLE_VECTOR_SEARCH=true
ENABLE_RAG=true
ENABLE_PDF_PROCESSING=true

# LangGraph configuration
LANGGRAPH_AVAILABLE=true
WORKFLOW_AVAILABLE=true

# Bypass Azure Key Vault (use environment variables instead)
BYPASS_AZURE_KEYVAULT=true

# ─────────────────────────────────────────────────────────────────────────────
# Logging Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Azure Application Insights (optional)
APPLICATIONINSIGHTS_CONNECTION_STRING=<your_app_insights_connection_string>

# Enable/disable logging features
ENABLE_FILE_LOGGING=true
ENABLE_CONSOLE_LOGGING=true
ENABLE_AZURE_LOGGING=true

# Log file paths
LOG_FILE_PATH=/home/logs/app.log
ERROR_LOG_PATH=/home/logs/error.log

# ─────────────────────────────────────────────────────────────────────────────
# SQLite Browser Configuration
# ─────────────────────────────────────────────────────────────────────────────

SQLITE_BROWSER_CONTAINER_NAME=sqlite-browser
SQLITE_BROWSER_IMAGE=coleifer/sqlite-web:latest
SQLITE_BROWSER_PORT=8080

# ─────────────────────────────────────────────────────────────────────────────
# Security Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Secret key for Flask sessions
SECRET_KEY=<generate_random_secret_key>

# CORS configuration
ALLOWED_ORIGINS=https://credit-risk-final.azurewebsites.net,http://localhost:3000

# Rate limiting
ENABLE_RATE_LIMITING=false
RATE_LIMIT_PER_MINUTE=60

# ─────────────────────────────────────────────────────────────────────────────
# Performance Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Connection pooling
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Cache configuration
ENABLE_CACHING=true
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300

# Request timeouts
REQUEST_TIMEOUT=300
API_TIMEOUT=60

# ─────────────────────────────────────────────────────────────────────────────
# Monitoring and Health Checks
# ─────────────────────────────────────────────────────────────────────────────

# Health check endpoints
HEALTH_CHECK_PATH=/api/modular/health
READINESS_CHECK_PATH=/api/modular/ready

# Enable metrics collection
ENABLE_METRICS=true
METRICS_PORT=9090

# ─────────────────────────────────────────────────────────────────────────────
# Development/Testing Configuration (Production: Set to false)
# ─────────────────────────────────────────────────────────────────────────────

DEBUG=false
TESTING=false
DEVELOPMENT=false

# Enable debug features (Production: false)
ENABLE_DEBUG_TOOLBAR=false
ENABLE_PROFILER=false

# ─────────────────────────────────────────────────────────────────────────────
# Vector Database Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Embedding model
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# Vector search parameters
VECTOR_SEARCH_TOP_K=5
VECTOR_SEARCH_SIMILARITY_THRESHOLD=0.7

# ─────────────────────────────────────────────────────────────────────────────
# RAG Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Document processing
MAX_DOCUMENT_SIZE_MB=10
SUPPORTED_DOCUMENT_FORMATS=pdf,txt,docx

# Chunk size for document processing
DOCUMENT_CHUNK_SIZE=1000
DOCUMENT_CHUNK_OVERLAP=200

# ─────────────────────────────────────────────────────────────────────────────
# Agentic Workflow Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Workflow timeouts
WORKFLOW_TIMEOUT=300
AGENT_TIMEOUT=60

# Maximum retries
MAX_WORKFLOW_RETRIES=3
MAX_AGENT_RETRIES=2

# ─────────────────────────────────────────────────────────────────────────────
# Cost Optimization
# ─────────────────────────────────────────────────────────────────────────────

# Enable cost tracking
ENABLE_COST_TRACKING=true

# Model usage preferences (cost optimization)
PREFER_SMALLER_MODELS=false
MAX_TOKENS_PER_REQUEST=4000

# ─────────────────────────────────────────────────────────────────────────────
# Notes
# ─────────────────────────────────────────────────────────────────────────────

# 1. Replace all <placeholders> with actual values
# 2. Never commit this file with real credentials to version control
# 3. Use Azure Key Vault for production secrets (set BYPASS_AZURE_KEYVAULT=false)
# 4. Generate a strong SECRET_KEY using: python -c "import secrets; print(secrets.token_hex(32))"
# 5. Store this file securely and restrict access
# 6. For local development, create a .env.local file
# 7. For production, use Azure App Service Configuration settings
